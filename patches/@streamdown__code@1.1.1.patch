+// Streaming code produces a new result for every prefix. Retain only recent,
+// bounded source content so token arrays from old revisions can be collected.
+const MAX_HIGHLIGHT_CACHE_ENTRIES = 32
+const MAX_HIGHLIGHT_CACHE_CHARACTERS = 256 * 1024
+let cachedCharacters = 0
+
+function cacheHighlight(key, result, characters) {
+  const existing = p.get(key)
+  if (existing) {
+    cachedCharacters -= existing.characters
+    p.delete(key)
+  }
+  if (characters > MAX_HIGHLIGHT_CACHE_CHARACTERS) return
+
+  while (
+    p.size >= MAX_HIGHLIGHT_CACHE_ENTRIES ||
+    cachedCharacters + characters > MAX_HIGHLIGHT_CACHE_CHARACTERS
+  ) {
+    const oldestKey = p.keys().next().value
+    cachedCharacters -= p.get(oldestKey).characters
+    p.delete(oldestKey)
+  }
+  p.set(key, { result, characters })
+  cachedCharacters += characters
+}
