{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "sortPackageJson": false,
  "ignorePatterns": [
    "out",
    "dist",
    "pnpm-lock.yaml",
    "LICENSE.md",
    "tsconfig.json",
    "tsconfig.*.json",
    "**/*.toml",
    ".yachiyo",
    "target",
    "packages/runtime/src/services/processBroker/processHostProtocol.generated.ts"
  ]
}
